{
  "name": "printer-dashboard",
  "version": "1.0.0",
  "description": "Floating 3D Printer Dashboard and RTSP viewer with Tray support",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node18 --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.ts --bundle --platform=node --target=node18 --outfile=dist-electron/preload.js --external:electron",
    "build": "tsc && vite build && yarn build:electron",
    "dev": "yarn build:electron && concurrently -k \"vite\" \"nix-shell -p electron ffmpeg --run 'NODE_ENV=development electron .'\"",
    "start": "nix-shell -p electron ffmpeg --run 'electron .'"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "esbuild": "^0.20.1",
    "postcss": "^8.4.35",
    "prettier": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
